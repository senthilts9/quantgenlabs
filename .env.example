ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
COPILOT_MAX_TOKENS=1024
QUANT_ENGINE=auto
GRAFANA_ADMIN_PASSWORD=
# Required by docker-compose when the postgres service is enabled. It was
# missing here while compose declared ${POSTGRES_PASSWORD:?...}, so anyone
# following this example hit a hard failure on `docker compose up`.
POSTGRES_PASSWORD=
