# Secrets — the deployed .env holds a live ANTHROPIC_API_KEY and the Grafana
# admin password. This repo had no .gitignore at all, so a single `git init`
# followed by `git add .` would have committed them.
.env
.env.*
!.env.example
*.pem
*.key

# Runtime data — the OMS SQLite book, its WAL, and Prometheus/Grafana volumes.
# ANCHORED with a leading slash. A bare `data/` matches a directory of that name
# at ANY depth, and it silently swallowed frontend/src/cryptodesk/data/, which
# holds mockData.ts — a SOURCE file the crypto desk imports. The result was a
# repo that could not build the crypto desk from a clean checkout: it worked on
# any machine that already had the file and failed in CI, which is exactly how
# it went unnoticed.
/backend/data/
/data/
*.db
*.db-shm
*.db-wal

# Build artefacts
node_modules/
dist/
build/
.venv/
venv/
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/

# Backtest output. `python backend/run_backtest.py` writes these next to the
# script; CI regenerates them every run. Ignored so `git add -A` cannot commit a
# stale tearsheet -- the one in docs/ is the deliberate, versioned copy.
backend/tearsheet.png
backend/equity_curve.csv

# Generated for IntelliSense by scripts/gen_compile_commands.sh. Holds absolute
# paths to this machine's interpreter and SDK, so it is per-machine by nature --
# committing it would point every other checkout at paths that do not exist.
cpp/compile_commands.json
# Debug binaries from the VS Code debug task (-O0 -g).
cpp/.debug/

# Editor / OS
.DS_Store
.idea/
# .vscode: ignore the personal/volatile files, COMMIT the project tooling. The
# five below are project configuration, not preference -- without them a fresh
# clone opens the C++ core with no include paths and no C++20, so every
# `#include "mkt/..."` and every concept reports an error that is not real.
# Anything else VS Code drops in here (per-user state, extension caches) stays
# ignored.
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json

# Hypothesis property-test database (machine-local falsifying examples)
.hypothesis/

# Local dev-server logs and screenshot captures. These are produced by running
# the stack by hand (`uvicorn ... > .uvicorn.log`, `vite > .vite.log`) and by
# screenshotting a screen to check it renders. They are dot-prefixed so they
# stay out of the way in a listing, which also means a careless `git add -A`
# would otherwise sweep a 180 KB PNG into the history.
/.uvicorn.log
/.vite.log
/.*.png
