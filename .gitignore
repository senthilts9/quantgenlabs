# Secrets — the deployed .env holds a live ANTHROPIC_API_KEY and the Grafana
# admin password. This repo had no .gitignore at all, so a single `git init`
# followed by `git add .` would have committed them.
.env
.env.*
!.env.example
*.pem
*.key

# Runtime data — the OMS SQLite book, its WAL, and Prometheus/Grafana volumes.
# ANCHORED with a leading slash. A bare `data/` matches a directory of that name
# at ANY depth, and it silently swallowed frontend/src/cryptodesk/data/, which
# holds mockData.ts — a SOURCE file the crypto desk imports. The result was a
# repo that could not build the crypto desk from a clean checkout: it worked on
# any machine that already had the file and failed in CI, which is exactly how
# it went unnoticed.
/backend/data/
/data/
*.db
*.db-shm
*.db-wal

# Build artefacts
node_modules/
dist/
build/
.venv/
venv/
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Hypothesis property-test database (machine-local falsifying examples)
.hypothesis/
