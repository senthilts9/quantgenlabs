{
  "version": 4,
  "configurations": [
    {
      "name": "quantgenlabs",

      // Exact per-file flags, generated by scripts/gen_compile_commands.sh.
      // This is the authority when it exists: three of the 24 sources are
      // pybind11 modules needing the Python C-API headers and the other 21 must
      // not see them, which a single flat includePath cannot express. Run the
      // script after adding a file or changing the venv (there is a task for it:
      // Terminal > Run Task > C++: regenerate compile_commands.json).
      "compileCommands": "${workspaceFolder}/cpp/compile_commands.json",

      // Fallback for a fresh clone where the database has not been generated
      // yet. It covers the header roots, which is enough to stop every
      // `#include "mkt/..."` showing as unresolved; the pybind11 modules will
      // still show red until the database exists, because their include paths
      // live outside the repo and cannot be hardcoded here portably.
      "includePath": [
        "${workspaceFolder}/cpp/include",
        "${workspaceFolder}/cpp/tests"
      ],

      // C++20 is not optional: the code uses concepts, designated initialisers
      // and <bit>. Left at the extension's default (C++17) every such file
      // reports syntax errors that are not real.
      "cStandard": "c17",
      "cppStandard": "c++20",

      "compilerPath": "/usr/bin/clang++",
      "intelliSenseMode": "macos-clang-x64",
      "browse": {
        "path": ["${workspaceFolder}/cpp"],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
